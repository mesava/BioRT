  "radiobiological_formulas": {
    "surviving_fraction_lq": {
      "formula": "SF = exp(-αD - βD²)",
      "parameters": {
        "alpha": "Gy⁻¹",
        "beta": "Gy⁻²",
        "D": "Dose (Gy)"
      }
    },
    "bed_calculation": {
      "formula": "BED = nd(1 + d/(α/β)) - (ln2/Tpot)×(T - Tk)",
      "parameters": {
        "n": "Number of fractions",
        "d": "Dose per fraction (Gy)",
        "alpha_beta": "Ratio (Gy)",
        "Tpot": "Potential doubling time (days)",
        "T": "Total treatment time (days)",
        "Tk": "Kick-off time (days)"
      },
      "note": "Repopulation term only applied when T > Tk"
    },
    "eqd2_calculation": {
      "formula": "EQD2 = D × (d + α/β) / (2 + α/β)",
      "parameters": {
        "D": "Total dose (Gy)",
        "d": "Dose per fraction (Gy)",
        "alpha_beta": "Ratio (Gy)"
      }
    },
    "tcp_niemierko": {
      "formula": "TCP = 1 / (1 + (TCD50/EUD)^(4×γ50))",
      "parameters": {
        "TCD50": "Dose for 50% tumor control (Gy)",
        "EUD": "Equivalent uniform dose (Gy)",
        "gamma50": "Normalized slope at TCD50 (typically ≥1)"
      }
    },
    "geud_calculation": {
      "formula": "gEUD = (Σ(vi × Di^(1/n)))^n",
      "parameters": {
        "vi": "Fractional volume receiving dose Di",
        "Di": "Dose in voxel i (Gy)",
        "n": "Tissue-specific parameter (negative for tumors, positive for OAR)"
      },
      "volume_effect": {
        "n_to_0": "Maximum dose dominates (serial organs)",
        "n_to_1": "Mean dose (parallel organs)",
        "typical_organs": {
          "n_negative_tumors": "-10",
          "n_positive_lung": "0.4"
        }
      }
    },
    "ntcp_lkb_model": {
      "formula": "NTCP = (1/√(2π)) ∫_{-∞}^t e^(-x²/2) dx",
      "reduction_formula": "t = (gEUD - TD50) / (m × TD50)",
      "parameters": {
        "TD50": "Tolerance dose for 50% complication (Gy)",
        "m": "Sigmoid curve slope parameter",
        "n": "Volume effect parameter (0=serial, 1=parallel)",
        "gEUD": "Generalized equivalent uniform dose"
      }
    },
    "tcp_poisson": {
      "formula": "TCP = exp(-N₀ × SF(D))",
      "parameters": {
        "N0": "Number of clonogenic cells",
        "SF": "Surviving fraction at dose D"
      }
    }
  },
