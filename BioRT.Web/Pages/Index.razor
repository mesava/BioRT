@page "/"
@using System.Text
@inject ModelCatalogService Catalog
@inject DicomBundleImporter DicomImporter
@inject PlanAnalysisService AnalysisService
@inject AnalysisResourceService AnalysisResources

<PageTitle>BioRT — TCP / NTCP из DICOM</PageTitle>

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">Radiotherapy biological plan evaluation</p>
        <h1>TCP / NTCP из DICOM — в браузере</h1>
        <p class="lead">
            BioRT объединяет физическую оценку плана, клинические дозовые критерии
            и воспроизводимые TCP/NTCP-модели с явной научной прослеживаемостью.
        </p>

        <div class="hero-actions">
            <a class="button primary" href="#calculator">Открыть калькулятор</a>
            <a class="button secondary" href="#models">Посмотреть модели</a>
        </div>

        <div class="notice">
            <strong>Режим разработки.</strong>
            Сайт уже выполняет локальную цепочку DICOM → DVH → физические метрики
            → clinical criteria → NTCP/TCP в браузере. Synthetic Web↔Console commissioning
            пройден; продолжается проверка на реалистичных деидентифицированных наборах.
        </div>
    </div>

    <div class="hero-metrics" aria-label="Состояние библиотеки">
        <article>
            <span class="metric-value">@NtcpModels.Count</span>
            <span class="metric-label">NTCP-моделей / записей</span>
        </article>
        <article>
            <span class="metric-value">@TcpModels.Count</span>
            <span class="metric-label">TCP-моделей / записей</span>
        </article>
        <article>
            <span class="metric-value">@RuntimeCount</span>
            <span class="metric-label">runtime-enabled</span>
        </article>
    </div>
</section>

<section id="calculator" class="section">
    <div class="section-heading">
        <p class="eyebrow">Калькулятор</p>
        <h2>Локальная обработка DICOM</h2>
        <p>
            Целевая архитектура сайта — обработка RTPLAN / RTDOSE / RTSTRUCT
            непосредственно в браузере. Данные пациента не должны уходить
            на внешний сервер только ради вычисления TCP/NTCP.
        </p>
    </div>

    <div class="calculator-card">
        <label class="dropzone">
            <span class="drop-icon">↥</span>
            <strong>Выберите ZIP или RTPLAN / RTDOSE / RTSTRUCT и JSON-контекст</strong>
            <span>
                Файлы и ZIP распаковываются непосредственно в вашем браузере.
                BioRT не отправляет выбранный DICOM на сервер.
                Monaco criteria JSON и clinical_context.json можно выбрать вместе с DICOM
                либо положить в тот же ZIP.
            </span>

            <InputFile class="file-input"
                       OnChange="HandleDicomFiles"
                       multiple
                       disabled="@IsImporting" />

            <span class="file-hint">
                Один согласованный набор: ZIP либо 1 RTPLAN + 1 RTDOSE + 1 RTSTRUCT.
                Criteria JSON рекомендуется; clinical_context.json — опционально.
                ZIP распаковывается только в памяти браузера.
            </span>
        </label>

        @if (IsImporting)
        {
            <div class="import-state">
                <strong>Читаю DICOM…</strong>
                <span>Проверяю SOP Class и загружаю только необходимые RT-объекты.</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ImportError))
        {
            <div class="import-state error">
                <strong>Набор не принят</strong>
                <span>@ImportError</span>
            </div>
        }
        else if (ImportedDicom != null)
        {
            <div class="import-result">
                <div class="import-result-heading">
                    <div>
                        <span class="status-dot"></span>
                        <strong>DICOM-набор прочитан локально</strong>
                    </div>
                    <span>Patient ID намеренно не показывается в web UI.</span>
                </div>

                <div class="import-stats">
                    <article>
                        <span class="metric-value small">@ImportedDicom.Plan.Fractions</span>
                        <span class="metric-label">фракций</span>
                    </article>
                    <article>
                        <span class="metric-value small">@ImportedDicom.Plan.DosePerFraction.ToString("F3")</span>
                        <span class="metric-label">Gy / fx</span>
                    </article>
                    <article>
                        <span class="metric-value small">@ImportedDicom.StructureNames.Count</span>
                        <span class="metric-label">ROI в RTSTRUCT</span>
                    </article>
                </div>

                <div class="source-files">
                    @foreach (string source in ImportedDicom.SourceFiles)
                    {
                        <span>@source</span>
                    }
                </div>

                @if (ImportedDicom.Warnings.Count > 0)
                {
                    <details class="import-warnings">
                        <summary>Предупреждения: @ImportedDicom.Warnings.Count</summary>
                        <ul>
                            @foreach (string warning in ImportedDicom.Warnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    </details>
                }
            </div>
        }

        @if (AnalysisResult != null)
        {
            <div class="analysis-summary">
                <div class="analysis-summary-top">
                    <div>
                        <p class="eyebrow">Результат расчёта</p>
                        <h3>Полный анализ выполнен локально</h3>
                        @if (!string.IsNullOrWhiteSpace(AnalysisFingerprint))
                        {
                            <p class="fingerprint">
                                Commissioning SHA-256:
                                <code>@AnalysisFingerprint</code>
                            </p>
                        }
                    </div>
                    <div class="analysis-context">
                        <span>@CriteriaStatus</span>
                        <span>@ClinicalContextStatus</span>
                    </div>
                </div>

                <div class="import-stats">
                    <article>
                        <span class="metric-value small">@AnalysisResult.Structures.Count</span>
                        <span class="metric-label">DVH структур</span>
                    </article>
                    <article>
                        <span class="metric-value small">@AnalysisResult.ClinicalCriteria.Count</span>
                        <span class="metric-label">критериев</span>
                    </article>
                    <article>
                        <span class="metric-value small">@AnalysisResult.Ntcp.Count</span>
                        <span class="metric-label">NTCP записей</span>
                    </article>
                </div>

                @if (AnalysisResult.PtvMetrics.Count > 0)
                {
                    <section class="result-block">
                        <h4>PTV / target metrics</h4>
                        <div class="table-scroll">
                            <table class="result-table">
                                <thead>
                                    <tr>
                                        <th>Structure</th>
                                        <th>Volume, cm³</th>
                                        <th>Rx, Gy</th>
                                        <th>D2</th>
                                        <th>D98</th>
                                        <th>D95</th>
                                        <th>D50</th>
                                        <th>HI</th>
                                        <th>CI</th>
                                        <th>GI</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ptv in AnalysisResult.PtvMetrics)
                                    {
                                        <tr>
                                            <td>@ptv.MatchedStructureName</td>
                                            <td>@ptv.VolumeCc.ToString("F2")</td>
                                            <td>@ptv.PrescriptionDoseGy.ToString("F2")</td>
                                            <td>@ptv.D2Gy.ToString("F2")</td>
                                            <td>@ptv.D98Gy.ToString("F2")</td>
                                            <td>@ptv.D95Gy.ToString("F2")</td>
                                            <td>@ptv.D50Gy.ToString("F2")</td>
                                            <td>@FormatMetric(ptv.Hi, 3)</td>
                                            <td>@FormatMetric(ptv.Ci, 3)</td>
                                            <td>@FormatMetric(ptv.Gi, 3)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }

                @if (AnalysisResult.ClinicalCriteria.Count > 0)
                {
                    <section class="result-block">
                        <h4>Clinical criteria</h4>
                        <div class="table-scroll">
                            <table class="result-table">
                                <thead>
                                    <tr>
                                        <th>Structure</th>
                                        <th>Criterion</th>
                                        <th>Value</th>
                                        <th>Result</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in AnalysisResult.ClinicalCriteria)
                                    {
                                        <tr>
                                            <td>@item.MatchedStructureName</td>
                                            <td>@item.Criterion.Raw</td>
                                            <td>@item.Value.ToString("F2")</td>
                                            <td>
                                                <span class="criterion-status @(item.Pass ? "pass" : "fail")">
                                                    @(item.Pass ? "PASS" : "FAIL")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }

                @if (AnalysisResult.Ntcp.Count > 0)
                {
                    <section class="result-block">
                        <h4>NTCP</h4>
                        <div class="bio-result-grid">
                            @foreach (var item in AnalysisResult.Ntcp)
                            {
                                <article class="bio-result-card">
                                    <div class="model-card-top">
                                        <span class="domain-badge">NTCP</span>
                                        <span class="status-badge @(item.Result.Status == NtcpEvaluationStatus.Calculated ? "enabled" : "reference")">
                                            @item.Result.Status
                                        </span>
                                    </div>
                                    <strong>@item.Result.ModelId</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.StructureName))
                                    {
                                        <p>@item.StructureName → @item.CanonicalStructure</p>
                                    }
                                    <p>@item.Result.EndpointName</p>
                                    <div class="bio-probability">@FormatProbability(item.Result.Probability)</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Result.Pmid))
                                    {
                                        <a class="source-link"
                                           href="@($"https://pubmed.ncbi.nlm.nih.gov/{item.Result.Pmid}/")"
                                           target="_blank"
                                           rel="noreferrer">
                                            PMID @item.Result.Pmid ↗
                                        </a>
                                    }
                                </article>
                            }
                        </div>
                    </section>
                }

                @if (AnalysisResult.Tcp != null)
                {
                    <section class="result-block">
                        <h4>TCP</h4>
                        <article class="bio-result-card tcp-card">
                            <div class="model-card-top">
                                <span class="domain-badge">TCP</span>
                                <span class="status-badge @(AnalysisResult.Tcp.Result.Status == TcpEvaluationStatus.Calculated ? "enabled" : "reference")">
                                    @AnalysisResult.Tcp.Result.Status
                                </span>
                            </div>
                            <strong>@AnalysisResult.Tcp.Result.ModelId</strong>
                            <p>@AnalysisResult.Tcp.Result.EndpointName</p>
                            <div class="bio-probability">@FormatProbability(AnalysisResult.Tcp.Result.Probability)</div>
                            @if (!string.IsNullOrWhiteSpace(AnalysisResult.Tcp.TargetStructureName))
                            {
                                <p>
                                    Target: @AnalysisResult.Tcp.TargetStructureName
                                    @if (AnalysisResult.Tcp.TargetVolumeCc is double tcpVolume)
                                    {
                                        <span> · @tcpVolume.ToString("F2") cm³</span>
                                    }
                                </p>
                            }
                            @if (!string.IsNullOrWhiteSpace(AnalysisResult.Tcp.Result.Pmid))
                            {
                                <a class="source-link"
                                   href="@($"https://pubmed.ncbi.nlm.nih.gov/{AnalysisResult.Tcp.Result.Pmid}/")"
                                   target="_blank"
                                   rel="noreferrer">
                                    PMID @AnalysisResult.Tcp.Result.Pmid ↗
                                </a>
                            }
                        </article>
                    </section>
                }

                @if (AnalysisResult.Warnings.Count > 0)
                {
                    <details class="import-warnings">
                        <summary>Предупреждения анализа: @AnalysisResult.Warnings.Count</summary>
                        <ul>
                            @foreach (string warning in AnalysisResult.Warnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    </details>
                }
            </div>
        }

        <div class="pipeline">
            <span>DICOM</span>
            <b>→</b>
            <span>DVH</span>
            <b>→</b>
            <span>Физические метрики</span>
            <b>→</b>
            <span>NTCP</span>
            <b>→</b>
            <span>TCP</span>
        </div>
    </div>
</section>

<section id="models" class="section">
    <div class="section-heading row-heading">
        <div>
            <p class="eyebrow">Модельный каталог</p>
            <h2>Показываем не только процент, но и источник модели</h2>
            <p>
                Каждая запись сохраняет endpoint, model family, applicability,
                runtime status и публикационный источник.
            </p>
        </div>

        <div class="filters" role="group" aria-label="Фильтр моделей">
            <button class="@FilterClass("all")" @onclick='() => SetFilter("all")'>Все</button>
            <button class="@FilterClass("NTCP")" @onclick='() => SetFilter("NTCP")'>NTCP</button>
            <button class="@FilterClass("TCP")" @onclick='() => SetFilter("TCP")'>TCP</button>
            <button class="@FilterClass("runtime")" @onclick='() => SetFilter("runtime")'>Только runtime</button>
        </div>
    </div>

    <div class="model-grid">
        @foreach (var model in FilteredModels)
        {
            <article class="model-card">
                <div class="model-card-top">
                    <span class="domain-badge">@model.Domain</span>
                    <span class="status-badge @(model.RuntimeEnabled ? "enabled" : "reference")">
                        @(model.RuntimeEnabled ? "runtime" : "reference")
                    </span>
                </div>

                <h3>@model.Id</h3>

                <p class="endpoint">@model.EndpointDisplay</p>

                @if (!string.IsNullOrWhiteSpace(model.PrimaryContext))
                {
                    <p class="context">@model.PrimaryContext</p>
                }

                <dl>
                    <div>
                        <dt>Family</dt>
                        <dd>@model.ModelFamily</dd>
                    </div>
                    <div>
                        <dt>Equation</dt>
                        <dd>@model.EquationId</dd>
                    </div>
                    <div>
                        <dt>Status</dt>
                        <dd>@model.Status</dd>
                    </div>
                </dl>

                @if (!string.IsNullOrWhiteSpace(model.Pmid))
                {
                    <a class="source-link"
                       href="@($"https://pubmed.ncbi.nlm.nih.gov/{model.Pmid}/")"
                       target="_blank"
                       rel="noreferrer">
                        PMID @model.Pmid ↗
                    </a>
                }
            </article>
        }
    </div>
</section>

<section id="science" class="section split-section">
    <article class="panel">
        <p class="eyebrow">Научная база</p>
        <h2>Model-aware, а не «таблица коэффициентов»</h2>
        <p>
            BioRT не смешивает TD50, m, n, D50, γ, α/β и другие параметры
            из разных публикаций в одну синтетическую модель.
        </p>
        <ul class="check-list">
            <li>TG-166 benchmark / gEUD / TCP mathematics</li>
            <li>source-specific fractionation handling</li>
            <li>endpoint и time point рядом с результатом</li>
            <li>Calculated / MissingInputs / NotApplicable / RuntimeDisabled</li>
        </ul>
    </article>

    <article id="privacy" class="panel privacy-panel">
        <p class="eyebrow">Данные пациента</p>
        <h2>Веб — не значит загрузка DICOM на сервер</h2>
        <p>
            Целевой production-вариант — статический WebAssembly-сайт:
            DICOM читается и рассчитывается локально в браузере.
        </p>
        <p>
            До завершения и независимой проверки клиентского DICOM-пайплайна
            публичный сайт должен использовать только синтетические или
            деидентифицированные наборы.
        </p>
    </article>
</section>

<section class="safety-strip">
    <strong>FOR DECISION SUPPORT ONLY.</strong>
    <span>BioRT не заменяет TPS, клинический протокол или решение врача.</span>
</section>

@code {
    private const long MaxBrowserFileSize =
        512L * 1024L * 1024L;

    private const long MaxJsonFileSize =
        5L * 1024L * 1024L;

    private const int MaxArchiveEntries = 100;

    private const long MaxArchiveExpandedSize =
        512L * 1024L * 1024L;

    private DicomImportResult? ImportedDicom;
    private PlanAnalysisResult? AnalysisResult;
    private string? ImportError;
    private string CriteriaStatus = "Criteria JSON: не найден";
    private string ClinicalContextStatus = "Clinical context: не задан";
    private string? AnalysisFingerprint;
    private bool IsImporting;

    private IReadOnlyList<CatalogModel> NtcpModels = Array.Empty<CatalogModel>();
    private IReadOnlyList<CatalogModel> TcpModels = Array.Empty<CatalogModel>();
    private string _filter = "all";

    private int RuntimeCount =>
        NtcpModels.Count(m => m.RuntimeEnabled) +
        TcpModels.Count(m => m.RuntimeEnabled);

    private IEnumerable<CatalogModel> AllModels =>
        NtcpModels.Concat(TcpModels);

    private IEnumerable<CatalogModel> FilteredModels =>
        _filter switch
        {
            "NTCP" => NtcpModels,
            "TCP" => TcpModels,
            "runtime" => AllModels.Where(m => m.RuntimeEnabled),
            _ => AllModels
        };

    protected override void OnInitialized()
    {
        NtcpModels = Catalog.LoadNtcpModels();
        TcpModels = Catalog.LoadTcpModels();
    }

    private async Task HandleDicomFiles(
        InputFileChangeEventArgs args)
    {
        ImportedDicom = null;
        AnalysisResult = null;
        AnalysisFingerprint = null;
        ImportError = null;
        CriteriaStatus = "Criteria JSON: не найден";
        ClinicalContextStatus = "Clinical context: не задан";
        IsImporting = true;

        try
        {
            IReadOnlyList<IBrowserFile> files =
                args.GetMultipleFiles(maximumFileCount: 50);

            if (files.Count == 0)
            {
                ImportError = "Не выбраны файлы.";
                return;
            }

            var inputs =
                new List<DicomInputFile>();

            var jsonInputs =
                new List<(string Name, string Json)>();

            foreach (IBrowserFile file in files)
            {
                if (file.Name.EndsWith(
                        ".zip",
                        StringComparison.OrdinalIgnoreCase))
                {
                    await using Stream zipStream =
                        file.OpenReadStream(
                            MaxBrowserFileSize);

                    IReadOnlyList<ArchiveBundleEntry> entries =
                        await ArchiveBundleReader.ReadAsync(
                            zipStream,
                            maxEntries: MaxArchiveEntries,
                            maxExpandedBytes: MaxArchiveExpandedSize);

                    foreach (ArchiveBundleEntry entry in entries)
                    {
                        if (entry.Name.EndsWith(
                                ".json",
                                StringComparison.OrdinalIgnoreCase))
                        {
                            if (entry.Bytes.LongLength > MaxJsonFileSize)
                            {
                                throw new InvalidOperationException(
                                    $"JSON inside ZIP is too large: '{entry.Name}'.");
                            }

                            jsonInputs.Add(
                                (entry.Name,
                                 Encoding.UTF8.GetString(entry.Bytes)));

                            continue;
                        }

                        inputs.Add(
                            ArchiveBundleReader.ToDicomInputFile(
                                entry));
                    }

                    continue;
                }

                if (file.Name.EndsWith(
                        ".json",
                        StringComparison.OrdinalIgnoreCase))
                {
                    jsonInputs.Add(
                        (file.Name,
                         await ReadBrowserTextFile(file)));

                    continue;
                }

                inputs.Add(
                    BrowserDicomInputFileFactory.Create(
                        file,
                        MaxBrowserFileSize));
            }

            ImportedDicom =
                await DicomImporter.LoadAsync(inputs);

            IReadOnlyList<DoseCriterion> criteria =
                Array.Empty<DoseCriterion>();

            ClinicalContext? clinicalContext = null;

            var criteriaCandidates =
                new List<(string Name, IReadOnlyList<DoseCriterion> Criteria)>();

            foreach ((string jsonName, string json) in jsonInputs)
            {
                string fileName =
                    Path.GetFileName(jsonName);

                if (string.Equals(
                        fileName,
                        "clinical_context.json",
                        StringComparison.OrdinalIgnoreCase))
                {
                    clinicalContext =
                        ClinicalContextLoader.LoadJson(json);

                    ClinicalContextStatus =
                        "Clinical context: загружен";

                    continue;
                }

                try
                {
                    IReadOnlyList<DoseCriterion> parsed =
                        MonacoCriteriaParser.ParseJson(json);

                    criteriaCandidates.Add(
                        (jsonName, parsed));
                }
                catch
                {
                    // The selected JSON is not a Monaco criteria file.
                }
            }

            if (criteriaCandidates.Count > 1)
            {
                throw new InvalidOperationException(
                    "Найдено несколько JSON с prescriptions. Выберите один criteria JSON.");
            }

            if (criteriaCandidates.Count == 1)
            {
                criteria =
                    criteriaCandidates[0].Criteria;

                CriteriaStatus =
                    $"Criteria JSON: {criteriaCandidates[0].Name} · {criteria.Count} критериев";
            }

            AnalysisResult =
                AnalysisService.Analyze(
                    new PlanAnalysisRequest
                    {
                        Plan = ImportedDicom.Plan,
                        StructureNames = ImportedDicom.StructureNames,
                        Contours = ImportedDicom.Contours,
                        Criteria = criteria,
                        ClinicalContext = clinicalContext,
                        StructureMatcher =
                            AnalysisResources.StructureMatcher,
                        NtcpLibrary =
                            AnalysisResources.NtcpLibrary,
                        TcpLibrary =
                            AnalysisResources.TcpLibrary
                    });

            AnalysisFingerprint =
                PlanAnalysisFingerprint.Compute(
                    ImportedDicom.Plan,
                    AnalysisResult);
        }
        catch (Exception ex)
        {
            AnalysisResult = null;
            ImportError = ex.Message;
        }
        finally
        {
            IsImporting = false;
        }
    }

    private static async Task<string> ReadBrowserTextFile(
        IBrowserFile file)
    {
        await using Stream stream =
            file.OpenReadStream(MaxJsonFileSize);

        using var reader =
            new StreamReader(stream);

        return await reader.ReadToEndAsync();
    }

    private static string FormatProbability(double? probability)
        => probability is double value
            ? $"{value * 100.0:F2}%"
            : "n/a";

    private static string FormatMetric(
        double value,
        int digits)
        => double.IsFinite(value)
            ? value.ToString($"F{digits}")
            : "n/a";

    private void SetFilter(string filter)
        => _filter = filter;

    private string FilterClass(string filter)
        => _filter == filter ? "filter active" : "filter";
}
